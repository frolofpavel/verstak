{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Verstak — Connected Eyes",
  "version": "0.2.0",
  "description": "Глаза Verstak: pair с desktop, attach вкладки, observe страницы в текущий run без clipboard.",
  "key": "",
  "permissions": ["activeTab", "scripting", "sidePanel", "nativeMessaging", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Verstak — глаза браузера",
    "default_popup": "sidepanel.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  }
}
